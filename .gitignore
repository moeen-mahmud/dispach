# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# secrets — manifests reference env var names; values live here and never in git
.env
.env.*
!.env.example

# agent-written memory. `memory_write` appends real notes beside the manifest, so a run inside
# examples/ leaves a file behind — it is the agent's data, not the repo's.
examples/*/memory/


# runtime state directory. Named literally because gitignore has no way to read brand.ts —
# `scripts/rename-brand.ts` reports this file as needing a manual edit after a rename.
.dispach/

# local agent tooling state
.remember/

# os
.DS_Store

# Local Docker test harness — tooling, the agent it scaffolds, and the secrets beside it.
# Kept out of the repo entirely: it exists to exercise a build on one machine, and
# `docker/Dockerfile` is a Phase 11 deliverable that has not started.
local_test/
.dockerignore
