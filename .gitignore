# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# compiled standalone binaries — `bun build --compile` output, 61-103 MB each
dist-bin/

# secrets — manifests reference env var names; values live here and never in git
.env
.env.*
!.env.example

# agent-written memory. `memory_write` appends real notes beside the manifest, so a run inside
# examples/ leaves a file behind — it is the agent's data, not the repo's.
examples/*/memory/


# runtime state directory. Named literally because gitignore has no way to read brand.ts —
# `scripts/rename-brand.ts` reports this file as needing a manual edit after a rename.
.dispach/

# local agent tooling state
.remember/

# os
.DS_Store

# Local Docker test harness — tooling, the agent it scaffolds, and the secrets beside it.
# Kept out of the repo entirely: it exists to exercise a build on one machine.
#
# `.dockerignore` used to be on this list, under a comment saying the Dockerfile was a phase that
# had not started. Both halves went stale and the second one hid the first: with no
# `.dockerignore`, every build shipped the whole tree — `.git/`, `node_modules/`, every `.env` —
# to the Docker daemon. It is committed now, deliberately, because a build context is a
# disclosure surface and the right contents of one are not a local preference.
local_test/
