{
    "name": "dispach",
    "version": "0.1.0",
    "description": "A lightweight, model-agnostic AI agent runtime \u2014 the CLI, the server, and a typed client.",
    "license": "Apache-2.0",
    "author": "Moeen Mahmud",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moeen-mahmud/dispach.git",
        "directory": "packages/cli"
    },
    "type": "module",
    "bin": {
        "dispach": "dist/index.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/client.d.ts",
            "default": "./dist/client.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "default": "./dist/client.js"
        },
        "./wire": {
            "types": "./dist/wire.d.ts",
            "default": "./dist/wire.js"
        },
        "./package.json": "./package.json"
    },
    "imports": {
        "#*": "./src/*.ts",
        "#components/*": "./src/components/*.tsx",
        "#plugins": "./src/plugins.ts"
    },
    "scripts": {
        "dev": "bun run ./src/index.ts",
        "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target node --format esm --splitting --production --sourcemap=linked --external ink --external react --external 'react/*' --banner '#!/usr/bin/env node' && bun build ./src/client.ts ./src/wire.ts --outdir dist --target node --format esm --production --sourcemap=linked && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "prepack": "cp ../../README.md ./README.md"
    },
    "dependencies": {
        "ink": "7.1.1",
        "react": "19.2.8"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@dispach/channel-telegram": "workspace:*",
        "@dispach/client": "workspace:*",
        "@dispach/core": "workspace:*",
        "@dispach/server": "workspace:*",
        "@dispach/tools-composio": "workspace:*",
        "@dispach/tools-system": "workspace:*",
        "@dispach/tools-web": "workspace:*",
        "@types/react": "19.2.18",
        "ink-testing-library": "4.0.0",
        "react-devtools-core": "6.1.5"
    },
    "keywords": [
        "ai",
        "agent",
        "runtime",
        "llm",
        "cli",
        "openai-compatible",
        "telegram"
    ],
    "homepage": "https://github.com/moeen-mahmud/dispach",
    "bugs": {
        "url": "https://github.com/moeen-mahmud/dispach/issues"
    }
}
