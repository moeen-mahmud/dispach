{
    "name": "@dispach/cli",
    "version": "0.1.0",
    "description": "Command line interface for the agent runtime.",
    "license": "Apache-2.0",
    "author": "Moeen Mahmud",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moeen-mahmud/dispach.git",
        "directory": "packages/cli"
    },
    "type": "module",
    "bin": {
        "dispach": "./dist/index.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "imports": {
        "#*": "./src/*.ts",
        "#components/*": "./src/components/*.tsx",
        "#plugins": "./src/plugins.ts"
    },
    "scripts": {
        "dev": "bun run ./src/index.ts",
        "build": "bun build ./src/index.ts --outdir dist --target node --format esm --splitting --sourcemap=linked --external '@dispach/core' --external ink --external react --external 'react/*' --banner '#!/usr/bin/env node' && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@dispach/channel-telegram": "workspace:*",
        "@dispach/client": "workspace:*",
        "@dispach/core": "workspace:*",
        "@dispach/server": "workspace:*",
        "@dispach/tools-composio": "workspace:*",
        "@dispach/tools-system": "workspace:*",
        "@dispach/tools-web": "workspace:*",
        "ink": "7.1.1",
        "react": "19.2.8"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/react": "19.2.18",
        "ink-testing-library": "4.0.0",
        "react-devtools-core": "6.1.5"
    }
}
