{
    "name": "@dispach/core",
    "version": "0.1.0",
    "description": "Lightweight, model-agnostic AI agent runtime \u2014 the loop, context, tools, and control.",
    "license": "Apache-2.0",
    "author": "Moeen Mahmud",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moeen-mahmud/dispach.git",
        "directory": "packages/core"
    },
    "type": "module",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "default": "./dist/testing/index.js"
        },
        "./wire": {
            "types": "./dist/wire/index.d.ts",
            "default": "./dist/wire/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && bun build ./src/index.ts ./src/testing/index.ts ./src/wire/index.ts --outdir dist --target node --format esm --splitting --sourcemap=linked --packages=external && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "yaml": "^2.8.1",
        "zod": "^4.1.12"
    },
    "private": true
}
