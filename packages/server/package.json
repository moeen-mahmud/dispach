{
    "name": "@dispach/server",
    "version": "0.1.0",
    "description": "HTTP, SSE and WebSocket surface — the wire protocol in 04-SPEC-WIRE.md.",
    "license": "Apache-2.0",
    "author": "Moeen Mahmud",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moeen-mahmud/dispach.git",
        "directory": "packages/server"
    },
    "type": "module",
    "files": [
        "dist",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target node --format esm --sourcemap=linked --packages=external && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@dispach/core": "workspace:*",
        "ws": "^8",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@dispach/web": "workspace:*",
        "@types/ws": "8.18.1"
    },
    "private": true
}
