{
    "name": "@dispach/media-aws",
    "version": "0.1.0",
    "description": "Amazon Transcribe and Nova Canvas as a media provider: voice notes to text, prompts to images.",
    "license": "Apache-2.0",
    "author": "Moeen Mahmud",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moeen-mahmud/dispach.git",
        "directory": "packages/media-aws"
    },
    "type": "module",
    "files": [
        "dist",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target node --format esm --sourcemap=linked --packages=external && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock-runtime": "3.1141.0",
        "@aws-sdk/client-polly": "3.1141.0",
        "@aws-sdk/client-transcribe-streaming": "3.1141.0",
        "@dispach/core": "workspace:*",
        "@dispach/model-bedrock": "workspace:*"
    },
    "private": true
}
