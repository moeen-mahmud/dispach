{
    "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "includes": [
            "**",
            "!**/dist",
            "!**/node_modules",
            "!**/*.tsbuildinfo",
            "!developer-docs/reference/openapi.json",
            "!evals/**/results.json",
            "!evals/index.json"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "domains": {
            "react": "recommended"
        },
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noExplicitAny": "error"
            },
            "style": {
                "noNonNullAssertion": "error",
                "useConst": "error"
            }
        }
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded",
            "quoteStyle": "double",
            "trailingCommas": "all",
            "arrowParentheses": "always"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/tsconfig*.json"],
            "json": { "parser": { "allowComments": true } }
        },
        {
            "includes": ["site/**/*.css"],
            "css": { "parser": { "tailwindDirectives": true } }
        }
    ]
}
