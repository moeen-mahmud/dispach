# Local secrets for this example. Ignored by git (.gitignore:9).
#
# Read by the manifest loader itself — a `.env` beside the manifest, with the real environment
# always winning over it. This is the path that works under Node as well as Bun.
MODEL_ID=deepseek-v4-pro
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=

COMPOSIO_API_KEY=


