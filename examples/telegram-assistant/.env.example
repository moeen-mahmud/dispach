# Copy to `.env` beside the manifest. The real environment always wins over this file.
#
# Only secrets live here. The model id and base URL are literals in agent.yaml, because they are
# not secrets and behind a variable they break the sandbox picker, let a stray .env change the
# resolved capabilities, and make `validate` check a different agent than the one you meant.

MODEL_API_KEY=

# From @BotFather with /newbot. The manifest names this variable; it never holds the value.
TELEGRAM_BOT_TOKEN=
